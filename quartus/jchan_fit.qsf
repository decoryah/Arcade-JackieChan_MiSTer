# jchan_core (the whole arcade board without the MiSTer framework) for the DE10-nano's Cyclone V, Quartus 17.0 Lite.
#   quartus_map jchan_core; quartus_fit jchan_core; quartus_sta jchan_core      (README.md)
# The ports of jchan_core are far more than the device's pins: use the `jchan_fit` revision (all ports virtual pins) to fit it alone.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY jchan_core
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY out
set_global_assignment -name SEARCH_PATH ../rtl
set_global_assignment -name SEARCH_PATH ../modules/cpu-fx68k
set_global_assignment -name SYSTEMVERILOG_FILE ../modules/cpu-fx68k/fx68kAlu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../modules/cpu-fx68k/uaddrPla.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../modules/cpu-fx68k/fx68k.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_snapram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_cen.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_toybox.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_m68k.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_board.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_sys.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_ymz280b.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_audio48.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_spr_dec.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_spr_band.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_spr.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_view2.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_mix.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_video.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/jchan_core.sv
set_global_assignment -name SDC_FILE jchan_core.sdc
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name ALLOW_ANY_RAM_SIZE_FOR_RECOGNITION ON

source jchan_virtpins.qsf

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
set_instance_assignment -name VIRTUAL_PIN ON -to audio48_l
set_instance_assignment -name VIRTUAL_PIN ON -to audio48_r
set_instance_assignment -name VIRTUAL_PIN ON -to audio48_valid
set_instance_assignment -name VIRTUAL_PIN ON -to audio_l
set_instance_assignment -name VIRTUAL_PIN ON -to audio_r
set_instance_assignment -name VIRTUAL_PIN ON -to audio_sum_l
set_instance_assignment -name VIRTUAL_PIN ON -to audio_sum_r
set_instance_assignment -name VIRTUAL_PIN ON -to audio_valid
set_instance_assignment -name VIRTUAL_PIN ON -to ev_l240_o
set_instance_assignment -name VIRTUAL_PIN ON -to in_dsw1
set_instance_assignment -name VIRTUAL_PIN ON -to in_extra
set_instance_assignment -name VIRTUAL_PIN ON -to in_p1
set_instance_assignment -name VIRTUAL_PIN ON -to in_p2
set_instance_assignment -name VIRTUAL_PIN ON -to in_sys
set_instance_assignment -name VIRTUAL_PIN ON -to irq_sub_en
set_instance_assignment -name VIRTUAL_PIN ON -to ld_addr
set_instance_assignment -name VIRTUAL_PIN ON -to ld_data
set_instance_assignment -name VIRTUAL_PIN ON -to ld_we
set_instance_assignment -name VIRTUAL_PIN ON -to m_halted
