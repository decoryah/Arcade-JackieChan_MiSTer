set_instance_assignment -name VIRTUAL_PIN ON -to sr1_valid
set_instance_assignment -name VIRTUAL_PIN ON -to sr2_ack
set_instance_assignment -name VIRTUAL_PIN ON -to sr2_addr
set_instance_assignment -name VIRTUAL_PIN ON -to sr2_data
set_instance_assignment -name VIRTUAL_PIN ON -to sr2_len
set_instance_assignment -name VIRTUAL_PIN ON -to sr2_req
set_instance_assignment -name VIRTUAL_PIN ON -to sr2_valid
set_instance_assignment -name VIRTUAL_PIN ON -to srom_ack
